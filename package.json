{
  "name": "once-action",
  "version": "0.1.1",
  "description": "Idempotency for Next.js Server Actions: the same key and input replay the stored result, a different input returns a mismatch, and an in-flight duplicate returns a conflict.",
  "license": "MIT",
  "author": "Pro Gineous <github@progineous.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit && node --import tsx --test test/*.test.ts",
    "example": "tsx examples/checkout.ts",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progineousgb/once-action.git"
  },
  "bugs": {
    "url": "https://github.com/progineousgb/once-action/issues"
  },
  "homepage": "https://github.com/progineousgb/once-action#readme",
  "keywords": [
    "nextjs",
    "server-actions",
    "idempotency",
    "app-router"
  ],
  "peerDependencies": {
    "next": ">=16.4.2 <17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
